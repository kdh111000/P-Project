# ── Supabase 연결 ──
# Supabase 프로젝트 URL
# Supabase API 키
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-api-key
IMPORT_USER_ID=실제_Supabase_사용자_UUID


# ── Chroma 연결 ──
# persistent: 로컬 파일에 저장
# http: 실행 중인 Chroma 서버에 연결
CHROMA_MODE=persistent

# 로컬 저장 경로 (프로젝트 루트 기준)
CHROMA_PATH=./DataBase/chroma_data

# 아래 설정은 CHROMA_MODE=http일 때만 사용
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=clothes_local

OPENAI_API_KEY=실제_OpenAI_API_키
OPENAI_VISION_MODEL=gpt-4.1-mini